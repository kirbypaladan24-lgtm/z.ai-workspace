		BackgroundTransparency = 1, Text = "—", TextColor3 = C.text,
		Font = Enum.Font.Code, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Right,
	}, statusCard)
	statusRows[def.key] = { dot = dot, value = value }
end

